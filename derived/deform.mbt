///|
using @core {fp_norm, fp_rank}

///|
/// A monomial `c * x_0^{e_0} ... x_{n-1}^{e_{n-1}}` in a weighted polynomial
/// ring, used to linearise the Jacobian map.
pub struct PolyTerm {
  exp : Array[Int32]
  coeff : Int32
}

///|
/// Weighted monomial basis truncated at weighted degree `maxdeg`.
pub struct WeightedBasis {
  weights : Array[Int32]
  maxdeg : Int32
  exps : Array[Array[Int32]]
  degs : Array[Int32]
}

///|
pub fn WeightedBasis::new(
  weights : Array[Int32],
  maxdeg : Int32,
) -> WeightedBasis {
  let exps : Array[Array[Int32]] = []
  let degs : Array[Int32] = []
  let cur : Array[Int32] = []
  for _ in 0..<weights.length() {
    cur.push(0)
  }
  gen_exps(0, 0, cur, exps, degs, weights, maxdeg)
  WeightedBasis::{ weights, maxdeg, exps, degs, }
}

///|
fn gen_exps(
  v : Int32,
  used : Int32,
  cur : Array[Int32],
  exps : Array[Array[Int32]],
  degs : Array[Int32],
  weights : Array[Int32],
  maxdeg : Int32,
) -> Unit {
  if v == weights.length() {
    let e : Array[Int32] = []
    for x in cur {
      e.push(x)
    }
    exps.push(e)
    degs.push(used)
  } else {
    let maxk = (maxdeg - used) / weights[v]
    for k in 0..<=maxk {
      cur[v] = k
      gen_exps(v + 1, used + k * weights[v], cur, exps, degs, weights, maxdeg)
    }
    cur[v] = 0
  }
}

///|
pub fn WeightedBasis::index_of(self : WeightedBasis, e : Array[Int32]) -> Int32 {
  let mut ans = -1
  for i in 0..<self.exps.length() {
    let x = self.exps[i]
    let mut same = true
    for j in 0..<x.length() {
      if x[j] != e[j] {
        same = false
      }
    }
    if same {
      ans = i
    }
  }
  ans
}

///|
pub fn WeightedBasis::degree_at(self : WeightedBasis, i : Int32) -> Int32 {
  self.degs[i]
}

///|
pub fn WeightedBasis::count_up_to(self : WeightedBasis, d : Int32) -> Int32 {
  let mut n = 0
  for x in self.degs {
    if x <= d {
      n = n + 1
    }
  }
  n
}

///|
/// Formal partial derivative `d/dx_i` of a polynomial.
pub fn derivative(p : Array[PolyTerm], i : Int32) -> Array[PolyTerm] {
  let out : Array[PolyTerm] = []
  for t in p {
    if t.exp[i] > 0 {
      let e : Array[Int32] = []
      for j in 0..<t.exp.length() {
        if j == i {
          e.push(t.exp[j] - 1)
        } else {
          e.push(t.exp[j])
        }
      }
      out.push(PolyTerm::{ exp: e, coeff: t.coeff * t.exp[i], })
    }
  }
  out
}

///|
/// Shift a polynomial by a monomial: `x^e * p`.
fn shift_poly(p : Array[PolyTerm], e : Array[Int32]) -> Array[PolyTerm] {
  let out : Array[PolyTerm] = []
  for t in p {
    let ne : Array[Int32] = []
    for j in 0..<e.length() {
      ne.push(t.exp[j] + e[j])
    }
    out.push(PolyTerm::{ exp: ne, coeff: t.coeff, })
  }
  out
}

///|
/// Rank of the ideal generated by the polynomials `gens` inside the truncated
/// weighted polynomial ring.  Columns are `(generator, multiplier monomial)`;
/// rows are monomials of the basis.  The rank equals `dim_F R / I` in the
/// truncation, and the quotient dimension is `#monomials - rank`.
pub fn ideal_rank(
  gens : Array[Array[PolyTerm]],
  basis : WeightedBasis,
  p : Int32,
) -> Int32 {
  let rows = basis.exps.length()
  let cols = gens.length() * rows
  let mat : Array[Array[Int32]] = []
  for _ in 0..<rows {
    let row : Array[Int32] = []
    for _ in 0..<cols {
      row.push(0)
    }
    mat.push(row)
  }
  for g in 0..<gens.length() {
    for m in 0..<rows {
      let shifted = shift_poly(gens[g], basis.exps[m])
      for t in shifted {
        let d = t.exp.length()
        let mut deg = 0
        for j in 0..<d {
          deg = deg + t.exp[j] * basis.weights[j]
        }
        if deg <= basis.maxdeg {
          let r = basis.index_of(t.exp)
          if r >= 0 {
            let c = g * rows + m
            mat[r][c] = fp_norm(mat[r][c] + t.coeff, p)
          }
        }
      }
    }
  }
  fp_rank(mat, p)
}

///|
/// Milnor number `mu = dim O/(d_0 f, ..., d_{n-1} f)`.
pub fn milnor_number(
  poly : Array[PolyTerm],
  weights : Array[Int32],
  p : Int32,
  maxdeg : Int32,
) -> Int32 {
  let basis = WeightedBasis::new(weights, maxdeg)
  let gens : Array[Array[PolyTerm]] = []
  for i in 0..<weights.length() {
    gens.push(derivative(poly, i))
  }
  basis.exps.length() - ideal_rank(gens, basis, p)
}

///|
/// Tjurina number `tau = dim O/(f, d_0 f, ..., d_{n-1} f)`.
pub fn tjurina_number(
  poly : Array[PolyTerm],
  weights : Array[Int32],
  p : Int32,
  maxdeg : Int32,
) -> Int32 {
  let basis = WeightedBasis::new(weights, maxdeg)
  let gens : Array[Array[PolyTerm]] = [poly]
  for i in 0..<weights.length() {
    gens.push(derivative(poly, i))
  }
  basis.exps.length() - ideal_rank(gens, basis, p)
}

///|
/// Hilbert function of the Jacobian (or Tjurina) algebra, degree by degree.
pub fn quotient_hilbert(
  poly : Array[PolyTerm],
  weights : Array[Int32],
  p : Int32,
  maxdeg : Int32,
  include_f : Bool,
) -> Array[Int32] {
  let basis = WeightedBasis::new(weights, maxdeg)
  let gens : Array[Array[PolyTerm]] = []
  if include_f {
    gens.push(poly)
  }
  for i in 0..<weights.length() {
    gens.push(derivative(poly, i))
  }
  let out : Array[Int32] = []
  let mut prev = 0
  for d in 0..<=maxdeg {
    let rows_idx : Array[Int32] = []
    for i in 0..<basis.exps.length() {
      if basis.degs[i] <= d {
        rows_idx.push(i)
      }
    }
    // Build the restricted matrix.
    let nr = rows_idx.length()
    let nc = gens.length() * nr
    let mat : Array[Array[Int32]] = []
    for _ in 0..<nr {
      let row : Array[Int32] = []
      for _ in 0..<nc {
        row.push(0)
      }
      mat.push(row)
    }
    for g in 0..<gens.length() {
      for mi in 0..<nr {
        let shifted = shift_poly(gens[g], basis.exps[rows_idx[mi]])
        for t in shifted {
          let mut deg = 0
          for j in 0..<t.exp.length() {
            deg = deg + t.exp[j] * basis.weights[j]
          }
          if deg <= d {
            // locate row
            let mut ri = -1
            for q in 0..<nr {
              if basis.exps[rows_idx[q]].length() == t.exp.length() {
                let x = basis.exps[rows_idx[q]]
                let mut same = true
                for j in 0..<x.length() {
                  if x[j] != t.exp[j] {
                    same = false
                  }
                }
                if same {
                  ri = q
                }
              }
            }
            if ri >= 0 {
              let c = g * nr + mi
              mat[ri][c] = fp_norm(mat[ri][c] + t.coeff, p)
            }
          }
        }
      }
    }
    let r = fp_rank(mat, p)
    let qd = nr - r
    out.push(qd - prev)
    prev = qd
  }
  out
}

///|
/// Helper to build a polynomial from exponent-coefficient pairs.
pub fn poly_of(terms : Array[(Array[Int32], Int32)]) -> Array[PolyTerm] {
  let out : Array[PolyTerm] = []
  for t in terms {
    let (e, c) = t
    out.push(PolyTerm::{ exp: e, coeff: c, })
  }
  out
}
